# ===================
# REQUIRED VARIABLES
# ===================

# Sign-in for the web UI. Password managers save these as a pair.
# APP_USERNAME defaults to "admin" (with a startup warning).
APP_USERNAME=admin
APP_PASSWORD=change-me

# TMDB API Key - get from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# Session secret for JWT tokens (generate with: openssl rand -base64 32)
SESSION_SECRET=generate-a-secret-with-openssl-rand-base64-32

# PostgreSQL password (generate a strong random password)
POSTGRES_PASSWORD=change-me

# Shared secret between web and momoshtrem, sent as X-Momoshtrem-Token.
# Both services read it; restart both after changing it.
# Generate with: openssl rand -hex 32
# If unset, momoshtrem's REST API is unauthenticated (startup warning).
BACKEND_API_TOKEN=generate-with-openssl-rand-hex-32

# ===================
# OPTIONAL VARIABLES
# ===================

# Jackett API key - get from Jackett web UI after first run (http://localhost:9117)
JACKETT_API_KEY=your-jackett-api-key

# The WebDAV address you enter in Infuse; shown on the status page.
# Defaults to http://localhost:36911/ when unset.
# WEBDAV_PUBLIC_URL=https://momoshtrem.duckdns.org:36911/

# Browser origins allowed to call momoshtrem's REST API directly (comma-separated).
# Leave unset: the web app calls it server-to-server, which needs no CORS.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI features (classifier, recommendations). Disabled when unset.
# ANTHROPIC_API_KEY=sk-ant-...

# Trakt (read-only), from https://trakt.tv/oauth/applications
# TRAKT_CLIENT_ID=your-trakt-client-id
# TRAKT_CLIENT_SECRET=your-trakt-client-secret

# Key for encrypting Trakt tokens at rest (generate with: openssl rand -hex 32)
# SECRET_KEY=generate-with-openssl-rand-hex-32

# Version string reported by /api/status (Docker build arg)
# MOMOSHTREM_VERSION=dev

# OpenSubtitles (for subtitle search/download)
# OPENSUBTITLES_API_KEY=your-opensubtitles-api-key
# OPENSUBTITLES_USERNAME=your-username
# OPENSUBTITLES_PASSWORD=your-password

# pgAdmin (optional, for database management)
# PGADMIN_EMAIL=admin@local.dev
# PGADMIN_PASSWORD=change-me

# Volume paths (defaults to ./data/{service} if unset)
# JACKETT_DATA=./data/jackett
# MOMOSHTREM_PGDATA=./data/pgdata
# MOMOSHTREM_CONFIG=./data/momoshtrem/config
# MOMOSHTREM_DATA=./data/momoshtrem/data

# ===================
# SIGN-IN HARDENING (optional)
# ===================
# Number of reverse proxies in front of the web app that append to
# X-Forwarded-For (1 behind Caddy). 0 = the web app is reached directly.
TRUSTED_PROXY_HOPS=0
# Rate limit: failures per client, failures from anyone, window and pause
# AUTH_MAX_ATTEMPTS=5
# AUTH_GLOBAL_MAX_FAILURES=30
# AUTH_WINDOW_MINUTES=15
# AUTH_BLOCK_MINUTES=15
