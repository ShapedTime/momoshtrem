# ===================
# REQUIRED VARIABLES
# ===================

# Sign-in for the web UI. Password managers save these as a pair.
# APP_USERNAME defaults to "admin" (with a startup warning).
APP_USERNAME=admin
APP_PASSWORD=change-me

# TMDB API Key - get from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# Session secret for JWT tokens (generate with: openssl rand -base64 32)
SESSION_SECRET=generate-a-secret-with-openssl-rand-base64-32

# PostgreSQL password (generate a strong random password)
POSTGRES_PASSWORD=change-me

# Shared secret between web and momoshtrem, sent as X-Momoshtrem-Token.
# Both services read it; restart both after changing it.
# Generate with: openssl rand -hex 32
# If unset, momoshtrem's REST API is unauthenticated (startup warning).
BACKEND_API_TOKEN=generate-with-openssl-rand-hex-32

# Data folders. compose refuses to start without them.
# The VM uses (docs/ops/HOST.md §4):
#   JACKETT_DATA=/mnt/data/jackett
#   MOMOSHTREM_PGDATA=/mnt/data/momoshtrem/pgdata
#   MOMOSHTREM_CONFIG=/mnt/data/momoshtrem/config
#   MOMOSHTREM_DATA=/mnt/data/momoshtrem/data
# Locally, use ./data (gitignored):
JACKETT_DATA=./data/jackett
MOMOSHTREM_PGDATA=./data/pgdata
MOMOSHTREM_CONFIG=./data/momoshtrem/config
MOMOSHTREM_DATA=./data/momoshtrem/data

# Caddy: the Caddyfile reads these.
# The public hostname: the web UI on 443 and WebDAV on 36911. Caddy gets a
# Let's Encrypt certificate for it over 443, so 443 must reach this host.
WEBDAV_HOST=your-domain.example.com
WEBDAV_USER=your-username
# Bcrypt hash of the password, from:
#   docker run --rm caddy:2.11.7-alpine caddy hash-password --plaintext 'YourPassword'
# Keep the single quotes: the hash has $ signs, which compose would otherwise
# read as variables.
WEBDAV_PASSWORD_HASH='$2a$14$paste-the-rest-of-the-hash'

# ===================
# OPTIONAL VARIABLES
# ===================

# TMDB language for names and overviews (momoshtrem), and its request rate.
# TMDB_LANGUAGE=en-US
# TMDB_RPS=20

# Jackett API key, for torrent search: momoshtrem queries Jackett with it (the
# web app never sees it). Get it from Jackett's web UI after the first run
# (http://localhost:9117).
JACKETT_API_KEY=your-jackett-api-key

# HDRezka as a second source of files, next to torrents. Off by default.
# Check it works from this host before turning it on (no database needed):
#   docker compose run --rm --no-deps momoshtrem hdrezka-probe interstellar
# HDREZKA_ENABLED=true
# The mirror to use, without a path (default https://rezka.ag).
# HDREZKA_URL=https://rezka.ag

# momoshtrem's BitTorrent port, TCP and uTP (default 42069). 0 picks a free
# port, so two instances can run side by side.
# TORRENT_LISTEN_PORT=42069

# The WebDAV address you enter in Infuse; shown on the status page.
# Defaults to http://localhost:36911/ when unset.
# WEBDAV_PUBLIC_URL=https://your-domain.example.com:36911/

# Clients allowed to reach pgAdmin on :5050; Caddy drops the rest.
# Several ranges are separated by spaces.
# LAN_CIDR=192.168.0.0/24

# Browser origins allowed to call momoshtrem's REST API directly (comma-separated).
# Leave unset: the web app calls it server-to-server, which needs no CORS.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI features (classifier, recommendations). Disabled when unset.
# ANTHROPIC_API_KEY=sk-ant-...

# Trakt (read-only), from https://trakt.tv/oauth/applications
# TRAKT_CLIENT_ID=your-trakt-client-id
# TRAKT_CLIENT_SECRET=your-trakt-client-secret

# Key for encrypting Trakt tokens at rest (generate with: openssl rand -hex 32)
# SECRET_KEY=generate-with-openssl-rand-hex-32

# Image tag for momoshtrem and web: the full commit SHA of a green main commit
# (docs/ops/CI.md). ops/deploy/deploy.sh sets it on the VM; leave it unset
# locally to build :dev.
# MOMOSHTREM_TAG=

# Version string reported by /api/status (Docker build arg, local builds only)
# MOMOSHTREM_VERSION=dev

# OpenSubtitles (for subtitle search/download). Secrets go here, not in
# config.yaml (ops PLAN D6). An empty value doesn't clear one in config.yaml.
# OPENSUBTITLES_API_KEY=your-opensubtitles-api-key
# OPENSUBTITLES_USERNAME=your-username
# OPENSUBTITLES_PASSWORD=your-password

# pgAdmin (optional, for database management)
# PGADMIN_EMAIL=admin@local.dev
# PGADMIN_PASSWORD=change-me

# ===================
# SIGN-IN HARDENING (optional)
# ===================
# Number of reverse proxies in front of the web app that append to
# X-Forwarded-For (1 behind Caddy). 0 = the web app is reached directly.
TRUSTED_PROXY_HOPS=1
# Rate limit: failures per client, failures from anyone, window and pause
# AUTH_MAX_ATTEMPTS=5
# AUTH_GLOBAL_MAX_FAILURES=30
# AUTH_WINDOW_MINUTES=15
# AUTH_BLOCK_MINUTES=15
# compose defaults this to true: Caddy serves the web UI over HTTPS. Set false
# only to sign in over plain HTTP, such as http://localhost:3000 on the host.
# SECURE_COOKIES=false

# Where the web app reaches WebDAV directly, to tell whether Infuse still plays
# when the API is down (default: http://momoshtrem:36911/)
# WEBDAV_INTERNAL_URL=http://momoshtrem:36911/
