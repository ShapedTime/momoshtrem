# momoshtrem configuration
#
# This file is optional. Settings are layered: built-in defaults, then this
# file (if present), then environment variables, which always win. A
# container can run on env vars alone.
#
# Environment variables:
#   DATABASE_URL              database.url (required)
#   BACKEND_API_TOKEN         server.api_token
#   CORS_ALLOWED_ORIGINS      server.cors_allowed_origins (comma-separated)
#   WEBDAV_PUBLIC_URL         server.webdav_public_url
#   WEBDAV_AUTH_ENABLED       server.webdav_auth.enabled (true/false)
#   WEBDAV_USERNAME           server.webdav_auth.username
#   WEBDAV_PASSWORD           server.webdav_auth.password
#   TMDB_API_KEY              tmdb.api_key
#   TMDB_LANGUAGE             tmdb.language (default en-US)
#   TMDB_RPS                  tmdb.rps (default 20)
#   JACKETT_URL               jackett.url
#   JACKETT_API_KEY           jackett.api_key
#   HDREZKA_ENABLED           hdrezka.enabled (true/false, default false)
#   HDREZKA_URL               hdrezka.url (default https://rezka.ag)
#   OPENSUBTITLES_API_KEY     opensubtitles.api_key
#   OPENSUBTITLES_USERNAME    opensubtitles.username
#   OPENSUBTITLES_PASSWORD    opensubtitles.password
#   ANTHROPIC_API_KEY         ai.anthropic_api_key
#   TRAKT_CLIENT_ID           trakt.client_id
#   TRAKT_CLIENT_SECRET       trakt.client_secret (optional; new Trakt apps have none)
#   SECRET_KEY                security.secret_key
#   METRICS_ENABLED           metrics.enabled (true/false)
#   METRICS_PORT              metrics.port
#
# Prefer env vars for secrets.

server:
  http_port: 4444
  webdav_port: 36911
  # Shared secret required in the X-Momoshtrem-Token header on every /api
  # request. Leave empty only for local development (startup warning).
  # api_token: ""
  # Browser origins allowed to call the REST API. Empty = no CORS headers
  # (the web app calls the API server-to-server and doesn't need CORS).
  # cors_allowed_origins: ["http://localhost:3000"]
  # The WebDAV address Infuse uses, reported by /api/status.
  # Defaults to http://localhost:<webdav_port>/
  # webdav_public_url: "https://momoshtrem.duckdns.org:36911/"
  # WebDAV authentication (optional)
  # webdav_auth:
  #   enabled: true
  #   username: "webdav"
  #   password: "your-secure-password"

# Postgres (required). Usually set via DATABASE_URL.
database:
  url: postgres://momoshtrem:change-me@postgres:5432/momoshtrem?sslmode=disable

torrent:
  metadata_folder: ./data/torrents
  global_cache_size: 92160    # MB
  add_timeout: 60            # seconds
  read_timeout: 120
  idle_enabled: true
  idle_timeout: 300
  start_paused: true
  drop_duplicate_peer_ids: true   # Prevent duplicate peer connections (reduces wasted chunks)
  max_unverified_mb: 64           # Cap in-flight unverified data in MB (0=unlimited)
  listen_port: 42069              # BitTorrent port, TCP and uTP (0 = any free port; TORRENT_LISTEN_PORT)

# Streaming buffer sizes for playback optimization
streaming:
  readahead_bytes: 33554432       # 32MB - buffer ahead of playback position
  urgent_buffer_bytes: 8388608    # 8MB - immediate buffer around seek position
  # header_priority_bytes: 10485760  # 10MB (default)
  # footer_priority_bytes: 5242880   # 5MB (default)

vfs:
  cache_dir: ./data/cache   # Persistent VFS tree cache

# Prometheus metrics (optional)
metrics:
  enabled: true
  port: 9090

tmdb:
  api_key: ""  # Or TMDB_API_KEY
  language: en-US   # Names and overviews; part of the TMDB cache key
  rps: 20           # Requests per second to TMDB (it allows about 50)

# Torrent search (optional). Or JACKETT_URL / JACKETT_API_KEY.
jackett:
  url: http://jackett:9117
  api_key: ""

# HDRezka, a second source of files (optional, off by default). Check it
# works from this host first: momoshtrem hdrezka-probe <title>
# hdrezka:
#   enabled: false
#   url: https://rezka.ag   # the mirror; no path

# Subtitle download (optional)
# opensubtitles:
#   api_key: ""
#   username: ""
#   password: ""

# AI classifier and recommendations (optional; disabled when empty)
# ai:
#   anthropic_api_key: ""

# Trakt, read-only (optional)
# trakt:
#   client_id: ""
#   client_secret: ""   # optional: new Trakt apps get no secret

# Encryption key for tokens at rest (needed once Trakt is connected)
# security:
#   secret_key: ""
