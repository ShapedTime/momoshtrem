# ===================
# REQUIRED VARIABLES
# ===================
# The app will fail to start without these

# Sign-in for the web UI. Password managers save these as a pair.
# APP_USERNAME defaults to "admin" (with a startup warning).
APP_USERNAME=admin
APP_PASSWORD=your-secure-password

# TMDB API Key - get from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# Session secret for JWT tokens (generate with: openssl rand -base64 32)
# MUST be at least 32 characters
SESSION_SECRET=your-session-secret-at-least-32-chars

# ===================
# OPTIONAL VARIABLES
# ===================
# These enable torrent search and streaming features
# The app will work without them but with reduced functionality

# Jackett Configuration (for torrent search)
# Get API key from Jackett dashboard after first run
JACKETT_URL=http://jackett:9117
JACKETT_API_KEY=your-jackett-api-key

# momoshtrem Configuration (for library management and streaming)
MOMOSHTREM_URL=http://momoshtrem:4444

# Shared secret sent to momoshtrem as X-Momoshtrem-Token.
# Must match BACKEND_API_TOKEN on the momoshtrem service.
# Generate with: openssl rand -hex 32
BACKEND_API_TOKEN=your-backend-api-token

# ===================
# SIGN-IN HARDENING (optional)
# ===================
# Number of reverse proxies in front of the web app that append to
# X-Forwarded-For (1 behind Caddy). 0 = the web app is reached directly.
TRUSTED_PROXY_HOPS=0
# Rate limit: failures per client, failures from anyone, window and pause
# AUTH_MAX_ATTEMPTS=5
# AUTH_GLOBAL_MAX_FAILURES=30
# AUTH_WINDOW_MINUTES=15
# AUTH_BLOCK_MINUTES=15

# ===================
# DEVELOPMENT
# ===================
# Answer every PLAN §6 endpoint from fixtures in the browser (MSW)
# NEXT_PUBLIC_API_MOCKING=enabled
